# Локальные файлы предпросмотра и сборки
.claude/
__pycache__/

# Прототип пикалки с паллетой и шарды габаритов: пока не приняты, в репозиторий
# их тащить незачем — это 10 тысяч файлов и 68 МБ.
proto/
data/dims/

# Лента апдейтов: её правит сервер (админка), а не выкладка кода. Держать
# файл в репозитории — значит ловить конфликт при каждой подтяжке сайта.
data/news.json

# Ленты контуров ведёт сервер, как и общую: в репозитории они ловят конфликт
# при каждой выкладке кода.
data/news-sales.json
data/news-antigen.json
